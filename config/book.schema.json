{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/latex-book-template/book.schema.json",
  "title": "Book configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "chapters"],
  "$defs": {
    "text": {"type": "string", "maxLength": 500},
    "dimension": {"type": "string", "pattern": "^(?:0|[0-9]+(?:\\.[0-9]+)?)(?:pt|mm|cm|in)$"},
    "color": {"type": "string", "pattern": "^(?:[0-9A-Fa-f]{6}|black|blue|brown|cyan|darkgray|gray|green|lightgray|lime|magenta|olive|orange|pink|purple|red|teal|violet|white|yellow)$"}
  },
  "properties": {
    "title": {"$ref": "#/$defs/text"},
    "subtitle": {"$ref": "#/$defs/text"},
    "author": {"$ref": "#/$defs/text"},
    "authors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"},
    "date": {"$ref": "#/$defs/text"},
    "description": {"type": "string", "maxLength": 4000},
    "chapters": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.(?:md|markdown)$"}},
    "cover_image": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_./-]+\\.(?:png|jpe?g|pdf)$"},
    "paper_size": {"enum": ["a4", "a5", "letter", "legal", "executive", "b5"]},
    "fonts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "main": {"$ref": "#/$defs/text"}, "sans": {"$ref": "#/$defs/text"},
        "mono": {"$ref": "#/$defs/text"}, "size": {"enum": ["10pt", "11pt", "12pt"]}
      }
    },
    "margins": {
      "type": "object", "additionalProperties": false,
      "properties": {"top": {"$ref": "#/$defs/dimension"}, "right": {"$ref": "#/$defs/dimension"}, "bottom": {"$ref": "#/$defs/dimension"}, "left": {"$ref": "#/$defs/dimension"}}
    },
    "link_colors": {
      "type": "object", "additionalProperties": false,
      "properties": {"link": {"$ref": "#/$defs/color"}, "url": {"$ref": "#/$defs/color"}, "cite": {"$ref": "#/$defs/color"}}
    },
    "document_class_options": {"type": "array", "uniqueItems": true, "items": {"enum": ["oneside", "twoside", "openany", "openright", "draft", "final"]}},
    "page_numbering": {"enum": ["arabic", "roman", "Roman", "alph", "Alph"]},
    "header_text": {"$ref": "#/$defs/text"},
    "footer_text": {"$ref": "#/$defs/text"},
    "table_of_contents": {"type": "boolean"},
    "list_of_figures": {"type": "boolean"},
    "list_of_tables": {"type": "boolean"}
  },
  "allOf": [{"not": {"required": ["author", "authors"]}}]
}
