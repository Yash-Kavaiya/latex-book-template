{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/latex-book-template/book.schema.json",
  "title": "Book configuration",
  "description": "The single source of truth for book metadata, typography, and page layout. Unknown fields are rejected so a typo cannot silently fail to take effect.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "author", "language", "chapters"],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 500},
    "optional_text": {"type": "string", "maxLength": 500},
    "dimension": {"type": "string", "pattern": "^(?:0|[0-9]+(?:\\.[0-9]+)?)(?:pt|mm|cm|in)$"},
    "color": {"type": "string", "pattern": "^(?:[0-9A-Fa-f]{6}|black|blue|brown|cyan|darkgray|gray|green|lightgray|lime|magenta|olive|orange|pink|purple|red|teal|violet|white|yellow)$"}
  },
  "properties": {
    "title": {"$ref": "#/$defs/text", "description": "Book title, shown on the cover and in the PDF metadata."},
    "subtitle": {"$ref": "#/$defs/optional_text", "description": "Optional line shown under the title on the cover page."},
    "author": {
      "description": "One author name, or a list of author names.",
      "oneOf": [
        {"$ref": "#/$defs/text"},
        {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      ]
    },
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$", "description": "BCP-47-style language tag, e.g. en-US."},
    "date": {"$ref": "#/$defs/optional_text", "description": "Cover-page date string, e.g. 2026-09-16. Leave unset to omit."},
    "description": {"type": "string", "maxLength": 4000, "description": "Optional short blurb shown under the title on the cover page."},
    "cover_image": {"type": ["string", "null"], "pattern": "^notes/.+\\.(?:png|jpe?g|pdf)$", "description": "Optional full-bleed cover image under notes/."},

    "chapters": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^notes/(?:[a-z0-9-]+/)*[0-9]{2}-[a-z0-9-]+\\.(?:md|markdown)$"},
      "description": "Ordered, unique chapter paths under notes/. This array is the sole source of publication order."
    },
    "bibliography": {"type": "string", "pattern": "^notes/.+\\.bib$", "description": "Optional BibTeX file under notes/ for citations."},

    "paper_size": {"enum": ["a4", "a5", "letter", "legal", "executive", "b5"], "description": "Default: a4."},
    "toc_depth": {"type": "integer", "minimum": 1, "maximum": 5, "description": "Table-of-contents depth. Default: 2."},
    "table_of_contents": {"type": "boolean", "description": "Default: true."},
    "list_of_figures": {"type": "boolean", "description": "Default: false."},
    "list_of_tables": {"type": "boolean", "description": "Default: false."},

    "fonts": {
      "type": "object", "additionalProperties": false,
      "description": "Locally installed font family names, resolved by XeLaTeX/fontconfig.",
      "properties": {
        "main": {"$ref": "#/$defs/text"},
        "sans": {"$ref": "#/$defs/text"},
        "mono": {"$ref": "#/$defs/text"},
        "size": {"enum": ["10pt", "11pt", "12pt"]}
      }
    },
    "margins": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "top": {"$ref": "#/$defs/dimension"}, "right": {"$ref": "#/$defs/dimension"},
        "bottom": {"$ref": "#/$defs/dimension"}, "left": {"$ref": "#/$defs/dimension"}
      }
    },
    "link_colors": {
      "type": "object", "additionalProperties": false,
      "properties": {"link": {"$ref": "#/$defs/color"}, "url": {"$ref": "#/$defs/color"}, "cite": {"$ref": "#/$defs/color"}}
    },
    "document_class_options": {
      "type": "array", "uniqueItems": true,
      "items": {"enum": ["oneside", "twoside", "openany", "openright", "draft", "final"]}
    },
    "page_numbering": {"enum": ["arabic", "roman", "Roman", "alph", "Alph"], "description": "Default: arabic."},

    "header_text": {"$ref": "#/$defs/optional_text", "description": "Centered running header on content pages. Defaults to the book title when unset."},
    "footer_text": {"$ref": "#/$defs/optional_text", "description": "Centered running footer on content pages, next to the page number. Empty by default."}
  }
}
