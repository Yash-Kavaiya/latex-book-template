{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "author", "language", "chapters"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string", "minLength": 1},
    "author": {"type": "string", "minLength": 1},
    "language": {"type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"},
    "date": {"type": ["string", "object"]},
    "papersize": {"enum": ["a4", "letter"]},
    "toc_depth": {"type": "integer", "minimum": 1, "maximum": 5},
    "mainfont": {"type": "string", "minLength": 1},
    "sansfont": {"type": "string", "minLength": 1},
    "monofont": {"type": "string", "minLength": 1},
    "bibliography": {"type": "string", "pattern": "^notes/.+\\.bib$"},
    "chapters": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^notes/(?:[a-z0-9-]+/)*[0-9]{2}-[a-z0-9-]+\\.md$"}
    }
  }
}
